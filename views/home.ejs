    height: 65px;    
  } 
  .block_oth:hover
  {
    background-color: #ddd;
      color: black;
  }

  .block_SOS {
    display: block;
    width: 300px;
    border: none;
    background-color: #000000;
    color: white;
    text-align: center;
    height: 70px;
    cursor: pointer;
    border-radius: 15px;
   
  } 

    .block:hover {
      background-color: #ddd;
      color: black;
    }
    a { color: inherit;
      text-decoration: none; } 

    /* a:hover{
      color: red;
    } */

      .container {
  position: relative;
  width: 100%;
}

.image {
  opacity: 1;
  display: block;
  width: 200px;
  height: auto;
  transition: .5s ease;
  backface-visibility: hidden;
  height: 200px;
}

.middle {
  transition: .5s ease;
  opacity: 0;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  -ms-transform: translate(-50%, -50%);
  text-align: center;
}

.container:hover .image {
  opacity: 0.2;
}

.container:hover .middle {
  opacity: 1;
}

.text {
  background-color: #00000000;
  color: rgb(3, 0, 0);
  font-size: 16px;
  padding: 16px 32px;
}

table {
    /* font-family: arial, sans-serif; */
    border-collapse: collapse;
    width: 100%;
    font-size: small;
    height: 120px;
  }
  
  td, th {
    border: 1px solid #b7c7ff;
    text-align: left;
    padding: 8px;
    height: 12px;
  }
  
  tr:nth-child(even) {
    background-color: #faf9fb;
  }
  tr:nth-child(odd) {
    background-color:  #dbe3fe;
  }
  select {
    border: 0;
    width: 100%;
    background-color: transparent;
}
.tooltip {
  position: relative;
  display: inline-block;
  border-bottom: 1px dotted black;
}

.tooltip .tooltiptext {
  visibility: hidden;
  width: 120px;
  background-color: transparent;
  color: rgb(0, 0, 0);
  text-align: center;
  border-radius: 6px;
  padding: 5px 0;

  /* Position the tooltip */
  position: absolute;
  z-index: 1;
}

.tooltip:hover .tooltiptext {
  visibility: visible;
}
pre{
  font-family:'Times New Roman', Times, serif ;
}
.userprofile
  {
    display: table-cell;
    border: solid 2px #333;
    height: 260px;
    border-radius: 15px;
