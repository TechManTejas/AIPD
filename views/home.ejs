            <label for="Doctor Name">Doctor Name:</label>
            <input class="input1" type="text" id="Doctor_name" readonly placeholder=<%= Doctor_name %>><br><br>
            <label for="Doctor Number">Doctor Number:</label>
            <input class="input1" type="text" id="Doctor_number" readonly placeholder=<%= Doctor_no %>><br><br>
            <label for="Doctor email">Doctor email:</label>
            <input class="input1" type="text" id="Doctor_email" readonly placeholder=<%= Doctor_email %>><br><br>
          </form>
        </div>
      </div>
