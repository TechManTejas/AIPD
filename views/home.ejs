  <div class="Row">
    <div class="Column ColumnMain" >
      <div class="profile">
      <div class="userprofile" style="margin-top: 20px;float: left;">
        <p><b>USER PROFILE</b></p>
        <img class="img_profile" src="images/Profile.png" alt="">
        <div class="details">
          <form>
            <label for="name">Name:</label>
            <input class="input1" type="text" id="name" name="name" readonly placeholder=<%= name %>><br><br>
            <label for="DateOfBirth">Date of Birth:</label>
            <input class="input1"type="text" id="DOB" name="DOB" readonly placeholder=<%= DOB %>><br><br>
            <label for="Patient ID">Patient ID:</label>
            <input class="input1" type="text" id="PID" readonly placeholder=<%= PID %>><br>
          </form>
        </div>
      </div>
      <div class="docprofile" style="margin-top: 5px;float: left;clear: left;">
        <p><b>DOCTOR PROFILE</b></p>
        <!-- <div cla> -->
        <img class="img_profile" src="images/p.jpg" alt="">
