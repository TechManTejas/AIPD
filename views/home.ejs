<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <script src="js/home.js" type="module" crossorigin="anonymous"></script>
  <link rel=”stylesheet” href=”dist/scripts/tailwind.css” />
</head>

<body>
  <!-- <ul>
    <li><a class="active" href="#home">Home</a></li>
    <li><a href="#Product">Our Product</a></li>
    <li><a href="#Blog">Blog</a></li>
</ul> -->
  <div class="Row">
    <div class="Column ColumnMain" >
      <div class="profile">
      <div class="userprofile" style="margin-top: 20px;float: left;">
        <p><b>USER PROFILE</b></p>
        <img class="img_profile" src="images/Profile.png" alt="">
        <div class="details">
          <form>
            <label for="name">Name:</label>
            <input class="input1" type="text" id="name" name="name" readonly placeholder=<%= name %>><br><br>
            <label for="DateOfBirth">Date of Birth:</label>
            <input class="input1"type="text" id="DOB" name="DOB" readonly placeholder=<%= DOB %>><br><br>
            <label for="Patient ID">Patient ID:</label>
            <input class="input1" type="text" id="PID" readonly placeholder=<%= PID %>><br>
          </form>
        </div>
      </div>
      <div class="docprofile" style="margin-top: 5px;float: left;clear: left;">
        <p><b>DOCTOR PROFILE</b></p>
        <!-- <div cla> -->
        <img class="img_profile" src="images/p.jpg" alt="">
          <form>
            <label for="Doctor Name">Doctor Name:</label>
            <input class="input1" type="text" id="Doctor_name" readonly placeholder=<%= Doctor_name %>><br><br>
            <label for="Doctor Number">Doctor Number:</label>
            <input class="input1" type="text" id="Doctor_number" readonly placeholder=<%= Doctor_no %>><br><br>
            <label for="Doctor email">Doctor email:</label>
            <input class="input1" type="text" id="Doctor_email" readonly placeholder=<%= Doctor_email %>><br><br>
          </form>
        </div>
      </div>
      </div>
    

    <div class="Column ColumnMain">
      <div>
        <div class="subColumn">
          <div class="subColumnInfo"></div>
          <div class="container">
            <img src="images/Elbow_Curl-gif.gif" alt="Avatar" class="image" style="width:100%">
            <div class="middle">
              <div class="tooltip">Elbow curl(without Weights)
                <!-- <span class="tooltiptext">
                  <pre><b>Please do the exercise slowly</b>
                    
                  </pre>
                </span> -->
              </div>
            </div>
          </div>
          ELBOW CURL (No Weights)
        </div>
        <div class="subColumn">
          <div class="subColumnInfo"></div>
          <div class="container">
            <img src="images/Cat_Cow-gif.gif" alt="Avatar" class="image" style="width:100%">
            <div class="middle">
              <div class="tooltip">Cat Cow
                <!-- <span class="tooltiptext">
                  <pre>
<b>Please do the exercise slowly</b>
                  </pre>
                </span> -->
              </div>
            </div>
          </div>
          CAT COW
        </div>
        <div class="subColumn">
          <div class="subColumnInfo"></div>
        <p style="font-size: 18px;font-weight: 800;font-family: 'Times New Roman';color: red;">WATCH  FULL EXERCISE VIDEO </p> 
        </div>
      </div>
     
      <div>
        <div class="subColumn">
          <div class="subColumnInfo"></div>
          <div class="container">
            <img src="images/Figure4_Stretch-gif.gif" alt="Avatar" class="image" style="width:100%">
            <div class="middle">
              <div class="tooltip"> Figure 4 Stretch
                <!-- <span class="tooltiptext">
                  <pre><b> Please do the exercise slowly</b>
                  </pre>
                </span> -->
                
              </div>
            </div>
          </div>
          FIGURE 4 STRETCH
        </div>
        <div class="subColumn">
          <div class="subColumnInfo"></div>
          <div class="container">
            <img src="images/kneetwist-gif.gif" alt="Avatar" class="image" style="width:100%">
            <div class="middle">
              <div class="tooltip">Knee Twist 
                <!-- <span class="tooltiptext">
                  <pre><b>For more information</b>
                  </pre>
                </span> -->
              </div>
            </div>
          </div>
          KNEE TWIST
        </div>
        <div class="subColumn">
          <div class="subColumnInfo"></div>
        <p style="font-size: 18px;font-weight: 800;font-family: 'Times New Roman';color: red;">UNDERSTAND THE EXERCISE</p> 
        </div>
      </div>
     
    </div>

    <div class="Column ColumnMain">
      <div class="profile">
        <p><b>EXERCISE : USER INPUT</b></p>
        <img  src="images/input.png" alt="" style="width: 150px;height:150px;margin-left: 70px;">
        <div class="details">
          <table><br>
          <form id="Patient_data"  method="post" action="/information">
            <tr>
            <td><label for="Exercise">Exercise:</label></td>
            <td><select id="Exercise" name="Exercise">
              <option value="Elbow Curl" selected="selected" >Elbow Curl</option>
              <option value="Cat Cow">Cat Cow</option>
              <!-- <option value="Knee Twist">Knee Twist</option> -->
              <option value="Figure4 Stretch">Figure4 Stretch</option>
            </select></td></tr>
            <tr>
            <td>  <label for="Exercise category">Exercise Category:</label></td>
             <td> <select id="Exercise_category" name="Exercise_category">
                <option value="1" selected="selected" >1</option>
                <option value="2">2</option>
                <option value="3">3</option>
              </select></td>
            </tr>
            <tr>
            <td><label for="Steps">Repetitions:</label></td>
            <td><select id="Steps" name="Steps">
              <option value="1" selected="selected" >1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
              <option value="7">7</option>
              <option value="8">8</option>
              <option value="9">9</option>
              <option value="10">10</option>
            </select></td>
            </tr>
            <tr>
            <td><label for="Sets">Sets:</label></td>
            <td><select id="Sets" name="Sets">
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4" selected="selected">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
              <option value="7">7</option>
              <option value="8">8</option>
              <option value="9">9</option>
              <option value="10">10</option>
            </select></td>
            </tr>
            <tr>
            <td><label for="q1">How are you feeling now ? </label></td>
            <td><select id="question1" name="q1">
              <option value="1" selected="selected">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select></td>
            </tr>
            <tr>
            <td><label for="q2">How is the pain now ?</label></td>
            <td><select id="question2" name="q2">
              <option value="1" selected="selected">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select></td>
            </tr>
            <tr>
            <td><label for="q3">Are you done with your meal ?</label></td>
            
            <td><select id="question3" name="q3">
              <option value="Yes">Yes</option>
              <option value="No" selected="selected">No</option>
            </select></td>
            </tr>
            <tr>
              <td><label for="q4">Did you watch the exercise videos ?</label></td>
              
              <td><select id="question4" name="q4">
                <option value="Yes">Yes</option>
                <option value="No" selected="selected">No</option>
              </select></td>
              </tr>
              <tr>
                <td><label for="q5">Rate our Exercise Information Catalog ?</label></td>
                <td><select id="question5" name="q5">
                  <option value="1" selected="selected">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>
                  <option value="5">5</option>
                </select></td>
                </tr>
            
            <!-- <input type="text" id="q1"required><br><br>
            <input type="text" id="q2"required><br><br> -->

          </form>
          </table>
        </div>
      </div>
    </div>

  </div>

  <div class="Row">
    <div class="Column1 ColumnMain1 block_oth">
        <br>
        <center> <b>
          <a href="/" style="font-size: 30px;font-family: 'Times New Roman';">Home</a>
            </b></center>
    </div>
    <div class="text-red-900">
        Legal Content/Disclaimer : The above tool is based on interpretation . In case of any
            disparity between the
            clinical and radiological findings, a repeat/review examination may be requested.
            This report is not valid for medico-legal purposes.</center>
    </div>
    <div class="Column1 ColumnMain1">
      <input id="information_submit" type="submit" form="Patient_data" value="Start" 
        class="bg-red-700"
      >
    </div>
</div>
  
</body>

</html>