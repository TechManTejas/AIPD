<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <style>
    body {
      margin: 0;
      padding: 0;
      text-align: center;
      overflow: hidden;
    }

    .Row {
      display: flex;
      flex-direction: row;
      width: 100%;
      /*Optional*/
      /*Optional*/
      border-spacing: 10px;
      /*Optional*/
    }

    .Column {
      display: table-cell;
      border: solid 2px #333;
      margin: 10px;
      /*Optional*/
    }

    .Column1 {
      display: table-cell;
      border: solid 2px #333;
      height: 60px;
      margin: 10px;
      /*Optional*/
    }

    .ColumnMain:nth-of-type(1) {
      height: 700px;
      width: 300px;
    }

    .ColumnMain:nth-of-type(2) {
      flex-grow: 2;
      height: 700px;
    }

    .ColumnMain:nth-of-type(3) {
      height: 700px;
      width: 300px;
    }

    .Column1:nth-of-type(1) {
      flex-grow: 1;
    }

    .Column1:nth-of-type(2) {
      flex-grow: 2;
      width: 200px;
    }

    .Column1:nth-of-type(3) {
      flex-grow: 1;
    }

    .InfoRow {
      display: flex;
      flex-direction: column;
    }

    .InfoColumn {
      height: 20px;
    }

    .InfoColumn p {
      margin: 0;
    }

    .volume-slider {
      width: 5px;
      background-color: rgb(4, 0, 255);
    }

    .block {
      display: block;
      width: 100%;
      border: none;
      background-color: #0a0f0d;
      color: white;
      padding: 14px 28px;
      font-size: 26px;
      cursor: pointer;
      text-align: center;
    }

    .block:hover {
      background-color: #ddd;
      color: black;
    }
    .block1 {
      display: block;
      width: 100%;
      margin-left: 13px;
      background-color: #0a0f0d;
      color: white;
      padding: 14px 28px;
      font-size: 10px;
      cursor: pointer;
      text-align: center;
    }

    .block1:hover {
      background-color: #ddd;
      color: black;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .column_button {
      margin-left: 90px;
    }
    .spacing{
      width: 100px;
    }

    * {box-sizing: border-box}

/* Full-width input fields */
  input[type=text], input[type=password] {
  width: 100%;
  padding: 15px;
  margin: 5px 0 22px 0;
  display: inline-block;
  border: none;
  background: #f1f1f1;
}

input[type=text]:focus, input[type=password]:focus {
  background-color: #ddd;
  outline: none;
}

hr {
  border: 1px solid #f1f1f1;
  margin-bottom: 25px;
}

/* Set a style for all buttons */
button {
  background-color: #000906;
  color: white;
  padding: 14px 20px;
  margin: 8px 0;
  border: none;
  cursor: pointer;
  width: 100%;
  opacity: 0.9;
}

button:hover {
  opacity:1;
}

/* Extra styles for the cancel button */
.cancelbtn {
  padding: 14px 20px;
  background-color: #090100;
}

/* Float cancel and signup buttons and add an equal width */
.cancelbtn, .signupbtn {
  float: left;
  width: 50%;
  
}

/* Add padding to container elements */
.container {
  padding: 16px;
  height: 620px;
}

/* Clear floats */
.clearfix::after {
  content: "";
  clear: both;
  display: table;
  border-color: #ccc;
}

/* Change styles for cancel button and signup button on extra small screens */
@media screen and (max-width: 300px) {
  .cancelbtn, .signupbtn {
    width: 100%;
  }
}



  </style>

</head>

<body>
  <div class="Row">
    <div class="Column ColumnMain">
<h2>Register Page</h2>
        <form action="/" style="border:1px solid #ccc">
            <div class="container">
              <h1>Sign Up</h1>
              <p>Please fill in this form to create an account.</p>
              <hr>
          
              <label for="email"><b>Email</b></label>
              <input type="text" placeholder="Enter Email" name="email" required>
          
              <label for="psw"><b>Password</b></label>
              <input type="password" placeholder="Enter Password" name="psw" required>
          
              <label for="psw-repeat"><b>Repeat Password</b></label>
              <input type="password" placeholder="Repeat Password" name="psw-repeat" required>
          
              <label>
                <input type="checkbox" checked="checked" name="remember" style="margin-bottom:15px"> Remember me
              </label>
          
              <p>By creating an account you agree to our <a href="#" style="color:dodgerblue">Terms & Privacy</a>.</p>
          
              <div class="clearfix">
                <button type="button" class="cancelbtn">Cancel</button>
                <button type="submit" class="signupbtn">Sign Up</button>
              </div>
            </div>
          </form>
    </div>

    <div class="Column ColumnMain">
      
    </div>

    
  </div>

  </div>

 
</body>

</html>