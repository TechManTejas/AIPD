<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <style>
    body {
      margin: 0;
      padding: 0;
      text-align: center;
    }

    .Row {
      display: flex;
      flex-direction: row;
      width: 100%;
      /*Optional*/
      /*Optional*/
      border-spacing: 10px;
      /*Optional*/
    }

    .Column {
      display: table-cell;
      border: solid 2px #333;
      margin: 10px;
      /*Optional*/
    }

    .Column1 {
      display: table-cell;
      border: solid 2px #333;
      height: 60px;
      margin: 10px;
      /*Optional*/
    }

    .ColumnMain:nth-of-type(1) {
      height: 700px;
      width: 300px;
    }

    .ColumnMain:nth-of-type(2) {
      flex-grow: 2;
      height: 700px;
    }

    .ColumnMain:nth-of-type(3) {
      height: 700px;
      width: 300px;
    }

    .Column1:nth-of-type(1) {
      flex-grow: 1;
    }

    .Column1:nth-of-type(2) {
      flex-grow: 2;
      width: 200px;
    }

    .Column1:nth-of-type(3) {
      flex-grow: 1;
    }

    .InfoRow {
      display: flex;
      flex-direction: column;
    }

    .InfoColumn {
      height: 20px;
    }

    .InfoColumn p {
      margin: 0;
    }

    .volume-slider {
      width: 5px;
      background-color: rgb(4, 0, 255);
    }

    .block {
      display: block;
      width: 100%;
      border: none;
      background-color: #0a0f0d;
      color: white;
      padding: 14px 28px;
      font-size: 26px;
      cursor: pointer;
      text-align: center;
    }

    .block:hover {
      background-color: #ddd;
      color: black;
    }
    .block1 {
      display: block;
      width: 100%;
      margin-left: 13px;
      background-color: #0a0f0d;
      color: white;
      padding: 14px 28px;
      font-size: 10px;
      cursor: pointer;
      text-align: center;
    }

    .block1:hover {
      background-color: #ddd;
      color: black;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .column_button {
      margin-left: 90px;
    }
    .spacing{
      width: 100px;
    }


    body {font-family: Arial, Helvetica, sans-serif;}
form {border: 3px solid #f1f1f1;}

input[type=text], input[type=password] {
  width: 100%;
  padding: 12px 20px;
  margin: 8px 0;
  display: inline-block;
  border: 1px solid #ccc;
  box-sizing: border-box;
}

button {
  background-color: #000906;
  color: white;
  padding: 14px 20px;
  margin: 8px 0;
  border: none;
  cursor: pointer;
  width: 100%;
}

button:hover {
  opacity: 0.8;
}

.cancelbtn {
  width: auto;
  padding: 10px 18px;
  background-color: #090100;
}

.imgcontainer {
  text-align: center;
  margin: 24px 0 12px 0;
}

img.avatar {
  width: 40%;
  border-radius: 50%;
}

.container {
  padding: 16px;
}

span.psw {
  float: right;
  padding-top: 16px;
}

/* Change styles for span and cancel button on extra small screens */
@media screen and (max-width: 300px) {
  span.psw {
     display: block;
     float: none;
  }
  .cancelbtn {
     width: 100%;
  }
}





  </style>

</head>

<body>
  <div class="Row">
    <div class="Column ColumnMain">
        <h2>Login Form</h2>

        <form action="/" method="get">
          <div class="imgcontainer">
            <img src="images/profilepic.png" alt="Avatar" class="avatar">
          </div>
        
          <div class="container">
            <label for="uname"><b>Username</b></label>
            <input type="text" placeholder="Enter Username" name="uname" required>
        
            <label for="psw"><b>Password</b></label>
            <input type="password" placeholder="Enter Password" name="psw" required>
                
            <button type="submit">Login</button>
            <label>
              <input type="checkbox" checked="checked" name="remember"> Remember me
            </label>
          </div>
        
          <div class="container" style="background-color:#f1f1f1">
            <button type="button" class="cancelbtn">Cancel</button>
            <span class="psw">Forgot <a href="#">password?</a></span>
          </div>
        </form>
    </div>

    <div class="Column ColumnMain">
      
    </div>

    
  </div>

  </div>

 
</body>

</html>